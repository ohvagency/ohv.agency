    /* =====================================
       01. 기본 설정
       ===================================== */

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #fff;
      color: #111;
      font-family: 'Pretendard', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }


    /* =====================================
       02. 전체 페이지 여백
       ===================================== */

    main {
      max-width: 1400px;
      min-height: 100vh;
      margin: 0 auto;
      padding: 180px 10% 120px;
    }


    /* =====================================
       03. 프로젝트 제목

       PC : 28px
       모바일 : 22px
       ===================================== */

    h1 {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: -0.04em;
      line-height: 1.3;
      margin: 0 0 16px;
      word-break: keep-all;
    }


    /* =====================================
       04. 프로젝트 소개글

       두 줄 정도 작성
       ===================================== */

    .description {
      max-width: 760px;
      font-size: 14px;
      line-height: 1.8;
      color: #777;
      margin: 0 0 55px;
      white-space: pre-line;
      word-break: keep-all;
    }


    /* =====================================
       05. 이미지 갤러리

       gap : 이미지 줄 사이 여백
       ===================================== */

    .gallery {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .image-row {
      display: grid;
      gap: 15px;
      align-items: start;
    }


    /* 한 줄에 이미지 1장 */
    .image-row.one {
      grid-template-columns: 1fr;
    }

    /* 한 줄에 이미지 2장 */
    .image-row.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* 한 줄에 이미지 3장 */
    .image-row.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }


    /* 이미지 원본 비율 유지 */
    .image-row img {
      display: block;
      width: 100%;
      height: auto;
    }


    /* =====================================
       06. 목록으로 돌아가기
       ===================================== */

    .back {
      display: inline-block;
      margin-top: 70px;
      font-size: 11px;
      letter-spacing: 1px;
      transition: opacity 0.2s;
    }

    .back:hover {
      opacity: 0.45;
    }


    /* =====================================
       07. 푸터
       ===================================== */

    footer {
      border-top: 1px solid #eee;
      padding: 35px 5%;
      font-size: 12px;
    }


    /* =====================================
       08. 모바일 화면
       ===================================== */

    @media (max-width: 650px) {

      main {
        padding: 150px 6% 80px;
      }

      h1 {
        font-size: 22px;
      }

      .description {
        font-size: 13px;
        margin-bottom: 35px;
      }

      .gallery,
      .image-row {
        gap: 8px;
      }

      .back {
        margin-top: 60px;
      }

    }

  </style>
