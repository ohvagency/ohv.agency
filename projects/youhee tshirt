              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen>
            </iframe>

          </div>

        </div>

      </div>

      -->


    </div>

  </main>


  <!-- =====================================
       13. 유튜브 영상 펼치기 / 접기

       처음 한 번만 설정하는 기능입니다.

       이후 영상이 늘어나도
       JavaScript 수정 불필요
       ===================================== -->

  <script>

    document.querySelectorAll('.video-text').forEach(button => {

      button.addEventListener('click', function() {

        const panel = document.getElementById(
          button.getAttribute('aria-controls')
        );

        if (!panel) return;

        const isOpen =
          button.getAttribute('aria-expanded') === 'true';

        const iframe = panel.querySelector('iframe');

        if (isOpen) {

          /* 영상 접기 */
          panel.hidden = true;

          button.setAttribute(
            'aria-expanded',
            'false'
          );

          /* 재생 중지 */
          if (iframe) {
            iframe.removeAttribute('src');
          }

        } else {

          /* 영상 펼치기 */
          panel.hidden = false;

          button.setAttribute(
            'aria-expanded',
            'true'
          );

          /* 영상 불러오기 */
          if (iframe && iframe.dataset.src) {
            iframe.src = iframe.dataset.src;
          }

        }

      });

    });

  </script>

</body>
</html>
